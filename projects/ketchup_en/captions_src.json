[
 ["Your ketchup started life", "Ton ketchup a commencé"],
 ["as a Chinese fish sauce.", "comme une sauce de poisson chinoise."],
 ["In southern China,", "Dans le sud de la Chine,"],
 ["people fermented fish", "on faisait fermenter du poisson"],
 ["into a salty sauce", "pour en faire une sauce salée"],
 ["called kê-tsiap.", "appelée kê-tsiap."],
 ["Around 1700,", "Vers 1700,"],
 ["English merchants tasted it in Asia,", "des marchands anglais la goûtent en Asie,"],
 ["and wanted it back home.", "et la veulent chez eux."],
 ["But they didn't have the fish.", "Mais ils n'ont pas le poisson."],
 ["So they faked it.", "Alors ils trichent."],
 ["Mushroom ketchup.", "Ketchup aux champignons."],
 ["Walnut ketchup.", "Ketchup aux noix."],
 ["Even oyster ketchup,", "Même aux huîtres,"],
 ["with a hundred oysters.", "avec cent huîtres."],
 ["Then in 1812,", "Puis en 1812,"],
 ["a Philadelphia scientist tried tomatoes.", "un scientifique de Philadelphie essaie la tomate."],
 ["He called them love apples.", "Il les appelle « pommes d'amour »."],
 ["Decades later,", "Des décennies plus tard,"],
 ["Heinz put it in a bottle.", "Heinz la met en bouteille."],
 ["The fish disappeared.", "Le poisson a disparu."],
 ["Only the Chinese name survived.", "Seul le nom chinois a survécu."],
 ["So every time you say ketchup,", "Alors chaque fois que tu dis ketchup,"],
 ["you're speaking a little Chinese.", "tu parles un peu chinois."]
