[
 ["Fish, not tomato.", "Du poisson, pas de la tomate."],
 ["Your ketchup started life", "Ton ketchup a commencé"],
 ["as a Chinese fish sauce.", "comme une sauce de poisson chinoise."],
 ["In southern China,", "Dans le sud de la Chine,"],
 ["they called it kê-tsiap.", "on l'appelait kê-tsiap."],
 ["Around 1700,", "Vers 1700,"],
 ["English merchants got hooked on it", "des marchands anglais l'adorent"],
 ["in Asia.", "en Asie."],
 ["But back home,", "Mais chez eux,"],
 ["there was no such fish.", "pas de ce poisson."],
 ["So they improvised:", "Alors ils improvisent :"],
 ["mushrooms, walnuts, oysters.", "champignons, noix, huîtres."],
 ["Tomato only showed up in 1812,", "La tomate n'arrive qu'en 1812,"],
 ["in an American recipe.", "dans une recette américaine."],
 ["And the bottled stuff?", "Et en bouteille ?"],
 ["A chef of the time", "Un chef de l'époque"],
 ["called it filthy and putrid.", "le dit sale et putride."],
 ["Then came Henry Heinz.", "Puis arrive Henry Heinz."],
 ["Thirty-one years old,", "Trente et un ans,"],
 ["and bankrupt.", "et ruiné."],
 ["He started over with ketchup.", "Il repart de zéro avec du ketchup."],
 ["In clear glass,", "Dans du verre transparent,"],
 ["so everyone could see", "pour que tout le monde voie"],
 ["exactly what was inside.", "ce qu'il y a dedans."],
 ["By 1905, Heinz had sold", "En 1905, Heinz a vendu"],
 ["five million bottles.", "cinq millions de bouteilles."],
 ["The fish is gone.", "Le poisson a disparu."],
 ["But its name", "Mais son nom"],
 ["is still on your table.", "est toujours sur ta table."]
]
